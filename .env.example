
# ==========================================
# MALVEDA BUILDERS - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# APPLICATION
# ------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Malveda Builders"

# ------------------------------------------
# SUPABASE
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# ------------------------------------------
# CLOUDFLARE R2 STORAGE
# ------------------------------------------
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=malveda-builders
R2_PUBLIC_URL=https://YOUR_PUBLIC_R2_DOMAIN

# ------------------------------------------
# ADMIN SEED
# ------------------------------------------
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ADMIN_SEED_NAME=Malveda Administrator

# ------------------------------------------
# SECURITY
# ------------------------------------------
APP_SESSION_SECRET=GENERATE_A_SECURE_RANDOM_SECRET

# ------------------------------------------
# OPTIONAL EMAIL SERVICE (FUTURE)
# ------------------------------------------
# RESEND_API_KEY=
# CONTACT_EMAIL=
